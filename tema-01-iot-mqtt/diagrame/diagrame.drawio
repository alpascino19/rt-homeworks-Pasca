00" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t111" value="eliberare periodică (pe grilă)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="826" width="260" height="24" as="geometry"/></mxCell><mxCell id="t112" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#c62828;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="854" as="sourcePoint"/><mxPoint x="760" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t113" value="termen-limită absolut d = r + D" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="780" y="826" width="300" height="24" as="geometry"/></mxCell><mxCell id="t114" value="" style="endArrow=block;endFill=0;html=1;strokeColor=#1f5fbf;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="45" y="894" as="sourcePoint"/><mxPoint x="45" y="862" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t115" value="eveniment acceptat → eliberare" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="868" width="280" height="24" as="geometry"/></mxCell><mxCell id="t116" value="" style="endArrow=cross;endFill=0;html=1;strokeColor=#c62828;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="894" as="sourcePoint"/><mxPoint x="400" y="862" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t117" value="eveniment respins" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="868" width="260" height="24" as="geometry"/></mxCell><mxCell id="t118" value="" style="endArrow=open;endSize=6;html=1;dashed=1;dashPattern=1 3;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="878" as="sourcePoint"/><mxPoint x="775" y="878" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t119" value="eveniment pus în coada alarmEvents" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="780" y="868" width="330" height="24" as="geometry"/></mxCell><mxCell id="t120" value="&lt;b&gt;Ce se vede în diagramă&lt;/b&gt;&lt;br&gt;• τ1 este eliberat pe grilă (așteptare absolută): r = 0, 2, 4 s; după SET_INTERVAL 1000 eliberarea următoare este r = 4 + 1 = 5 s, apoi 6, 7, 8, 9, 10 s.&lt;br&gt;• Jobul τ1 de la t = 2 s citește 29.6 °C &amp;gt; 28 °C și pune un eveniment în coadă; τ2 este eliberat (prima alarmă) și o publică, cu R ≈ 25 ms ≤ D = 500 ms.&lt;br&gt;• Evenimentul de la t = 4 s (28.6 °C) este &lt;b&gt;respins&lt;/b&gt;: au trecut doar 2 s de la eliberarea precedentă a lui τ2 (minim 5 s), deci nu se publică nimic.&lt;br&gt;• La t = 8 s (29.3 °C) au trecut 6 s ≥ 5 s, deci evenimentul este acceptat și alarma se publică. Între ele, la 5, 6, 7 s temperatura este sub prag.&lt;br&gt;• τ3 este eliberat de sosirea comenzii (t = 4.6 s), moment care nu poate fi prevăzut; jobul schimbă perioada lui τ1 și publică confirmarea pe topic-ul status.&lt;br&gt;• Fiecare task rulează pe thread-ul lui, iar procesorul are mai multe nuclee: joburile nu se preemptează și nu așteaptă în Ready (jobul τ1 și jobul τ2 pornit de el se suprapun aproape)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="910" width="1500" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>