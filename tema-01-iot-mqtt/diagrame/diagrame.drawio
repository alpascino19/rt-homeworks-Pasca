r=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="160" as="sourcePoint"/><mxPoint x="1120" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k44" value="inbox ×3&lt;br&gt;(BlockingQueue)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1035" y="166" width="90" height="40" as="geometry"/></mxCell><mxCell id="k45" value="" style="endArrow=open;endSize=8;html=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="160" as="sourcePoint"/><mxPoint x="1350" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k46" value="append()" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1300" y="164" width="60" height="20" as="geometry"/></mxCell><mxCell id="k47" value="updateTelemetry()&lt;br&gt;recordAlarm()&lt;br&gt;recordStatus()" style="endArrow=open;endSize=8;html=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1215" y="195" as="sourcePoint"/><mxPoint x="1215" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k48" value="print(), knows()" style="endArrow=open;endSize=8;html=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1215" y="440" as="sourcePoint"/><mxPoint x="1215" y="346" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k49" value="commands" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="468" as="sourcePoint"/><mxPoint x="1040" y="468" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k50" value="«artifact»&lt;br&gt;&lt;b&gt;data/*.csv&lt;/b&gt;" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1345" y="600" width="125" height="60" as="geometry"/></mxCell><mxCell id="k51" value="«write»" style="endArrow=open;endSize=8;html=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1407" y="188" as="sourcePoint"/><mxPoint x="1407" y="600" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k52" value="Operator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1195" y="590" width="40" height="70" as="geometry"/></mxCell><mxCell id="k53" value="comenzi de la tastatură&lt;br&gt;show, device-1 SET_INTERVAL 1000 …" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1215" y="590" as="sourcePoint"/><mxPoint x="1215" y="496" as="targetPoint"/></mxGeometry></mxCell><mxCell id="k54" value="&lt;b&gt;Notație&lt;/b&gt;&lt;br&gt;• dreptunghi «component»: o parte a sistemului care se poate înlocui independent; dreptunghiurile albe din interior sunt părțile (clasele) componentei&lt;br&gt;• bila (○): interfața pe care o &lt;i&gt;oferă&lt;/i&gt; componenta (brokerul oferă IMqtt); semicercul (⊂): interfața pe care o &lt;i&gt;folosește&lt;/i&gt; componenta&lt;br&gt;• săgeată plină: flux de date (mesaje MQTT sau cozi BlockingQueue între thread-uri); săgeată întreruptă: apel de metodă («use»)&lt;br&gt;&lt;br&gt;&lt;b&gt;Topic-uri&lt;/b&gt; (prefix &lt;code&gt;ssatr/pasca/devices/&amp;lt;id&amp;gt;/&lt;/code&gt;)&lt;br&gt;• &lt;code&gt;telemetry&lt;/code&gt;: device → service, task periodic, &lt;code&gt;deviceId;timestamp;temperatura&lt;/code&gt;&lt;br&gt;• &lt;code&gt;alarm&lt;/code&gt;: device → service, task sporadic, &lt;code&gt;deviceId;timestamp;temperatura;prag&lt;/code&gt;&lt;br&gt;• &lt;code&gt;commands&lt;/code&gt;: service → device, task aperiodic, &lt;code&gt;SET_INTERVAL 1000&lt;/code&gt;&lt;br&gt;• &lt;code&gt;status&lt;/code&gt;: device → service, confirmarea taskului aperiodic, &lt;code&gt;deviceId;timestamp;OK SET_INTERVAL 1000&lt;/code&gt;&lt;br&gt;• business-service se abonează cu wildcard-ul &lt;code&gt;+&lt;/code&gt; (orice device): &lt;code&gt;ssatr/pasca/devices/+/telemetry&lt;/code&gt; etc." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="1080" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="a" name="Secvență: alarmă"><mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1130" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a1" value="Diagramă de secvență 1: telemetria depășește pragul și produce o alarmă" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1520" height="30" as="geometry"/></mxCell><mxCell id="a2" value="device-1, prag 28.00 °C, intervalul minim între sosiri al alarmelor 5000 ms" style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1520" height="36" as="geometry"/></mxCell><mxCell id="a3" value="device-simulator (device-1)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="790" height="860" as="geometry"/></mxCell><mxCell id="a4" value="business-service" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;stro